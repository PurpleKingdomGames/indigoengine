+  private[webgl2] def decideBufferSizes(fullWidth: Int, fullHeight: Int): List[(Int, Int)] =
+    @tailrec
+    def rec(w: Int, h: Int, acc: List[(Int, Int)]): List[(Int, Int)] =
+      if w <= 100 || h <= 100 then acc :+ (w, h)
+      else rec(w / 2, h / 2, acc :+ (w, h))
+    
+    rec(fullWidth / 2, fullHeight / 2, List((fullWidth, fullHeight)))
+
+  /** Creates an array of framebuffers based on magnification, starts at 1 (not 0), magnification cannot be < 1, and
+    * each subsequent buffer is halfed in size until one dimension or the other is < 100, so:
+    *   - 800x600 @ mag 1 = 800x600
+    *   - 800x600 @ mag 2 = 400x300
+    *   - 800x600 @ mag 3 = 200x150
+    *   - 800x600 @ mag 4 = 100x75
+    */
+  def createFrameBufferArray(
+      gl: WebGLRenderingContext,
+      fullWidth: Int,
+      fullHeight: Int
+  ): Array[FrameBufferComponents.SingleOutput] =
+    decideBufferSizes(fullWidth, fullHeight)
+      .map { case (w, h) => FrameBufferFunctions.createFrameBufferSingle(gl, w, h) }
+      .toArray
+    
+  private def clampToRange(value: Int, max: Int): Int =
+    Math.min(max, Math.max(0, value))
+    
+  private[webgl2] def clampMagnification(magnification: Option[Int], max: Int): Int =
+    // -1 to make it zero indexed...
+    clampToRange(magnification.getOrElse(1) - 1, max) 
+    
+  def selectBufferByMagnification(
+      magnification: Option[Int],
+      buffers: => Array[FrameBufferComponents.SingleOutput]
+  ): FrameBufferComponents.SingleOutput =
+    val m = clampMagnification(magnification, buffers.length - 1)
+    buffers(m)
 
